# Server environment - copy to .env and adjust values
# Required: generate a strong random value for production
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postapi
JWT_SECRET=dev-secret-change-me
# Relative to server/src (../.. = project root) or absolute path
UPLOAD_DIR=../uploads
# Optional
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
