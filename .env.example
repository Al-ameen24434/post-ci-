# Root environment - used by docker-compose (see server/.env.example for details)
# Copy to .env if you need root-level env vars, or use server/.env and client/.env

# Database (used by docker-compose db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postapi
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postapi

# API
PORT=4000
JWT_SECRET=dev-secret-change-me
UPLOAD_DIR=./uploads
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Client
VITE_API_URL=http://localhost:4000
VITE_PORT=5173
